# OneMap (free SG government API — sign up at https://www.onemap.gov.sg/apidocs/register)
# Powers POI search (PlaceSearchInput), drive routing (plan flow), and
# public-transit routing (FairnessPill 🚆 toggle).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Google Places API (New). Free $200/mo credit covers ~10k venue lookups.
# Sign up at https://console.cloud.google.com/apis/library/places.googleapis.com
# and enable billing (no card charged within the credit).
GOOGLE_PLACES_API_KEY=

# Foursquare Places API (v3). Free 1,000 calls/day, no card. Used as the
# automatic fallback when Google Places returns 429 or 403.
# Sign up at https://foursquare.com/developers
FOURSQUARE_API_KEY=

# Google Gemini API (free tier, no card). Powers:
#   • blog scanner — extracts venue name/address/tags from food-blog articles
#     (Seth Lui, DFD, Miss Tam Chiak, Ladyironchef → /api/cron/sync-blogs)
#   • museum agent — discovers ArtScience/NHB/Gardens exhibitions via search
#   • plan eval pass — per-venue reasoning copy
# Sign up at https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# Conversational planner (F1) — the refine-after-results loop. Ships dark.
# AGENTIC_CHAT_ENABLED gates the /api/plan/refine endpoint (server);
# NEXT_PUBLIC_AGENTIC_CHAT_ENABLED gates the refine UI (client). Set BOTH to
# 'true' to enable. Uses GOOGLE_GEMINI_API_KEY (orchestration model — see
# lib/agents/models.ts ORCHESTRATION_MODEL).
AGENTIC_CHAT_ENABLED=
NEXT_PUBLIC_AGENTIC_CHAT_ENABLED=

# Whole-evening itinerary composition (F2) — on-demand "✨ Evening" view that
# sequences a dinner + activity with travel legs + timing feasibility. Ships
# dark. AGENTIC_ITINERARY_ENABLED gates /api/plan/itinerary (server);
# NEXT_PUBLIC_AGENTIC_ITINERARY_ENABLED gates the view toggle (client). Set BOTH.
AGENTIC_ITINERARY_ENABLED=
NEXT_PUBLIC_AGENTIC_ITINERARY_ENABLED=

# Verifier debate (F4) — server-only, cron-side. When 'true', the blog-extraction
# verifier runs a proposer/skeptic debate + deterministic tie-break instead of a
# single judge (higher precision; doubles verifier LLM calls per row). Ships dark;
# single-judge behaviour is unchanged when unset.
AGENTIC_VERIFIER_DEBATE=

# Supabase (Postgres + RLS for venues, profiles, shortlist_events).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side mirrors. Required for the Supabase JS client when used
# from a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — gates /api/cron/* and /api/admin/reseed.
# Set this in Vercel and Vercel auto-injects it as
# `Authorization: Bearer <secret>` on every scheduled cron call (CRON_SECRET
# is a Vercel-reserved name). For manual local triggers, pass the same
# header yourself: curl -H "Authorization: Bearer $CRON_SECRET" …
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional — gates /api/prewarm.
PREWARM_TOKEN=
