# OneMap (free SG government API — sign up at https://www.onemap.gov.sg/apidocs/register)
# Powers POI search (PlaceSearchInput), drive routing (plan flow), and
# public-transit routing (FairnessPill 🚆 toggle).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Google Places API (New). Free $200/mo credit covers ~10k venue lookups.
# Sign up at https://console.cloud.google.com/apis/library/places.googleapis.com
# and enable billing (no card charged within the credit).
GOOGLE_PLACES_API_KEY=

# Foursquare Places API (v3). Free 1,000 calls/day, no card. Used as the
# automatic fallback when Google Places returns 429 or 403.
# Sign up at https://foursquare.com/developers
FOURSQUARE_API_KEY=

# Google Gemini API (free tier, no card). Powers:
#   • blog scanner — extracts venue name/address/tags from food-blog articles
#     (Seth Lui, DFD, Miss Tam Chiak, Ladyironchef → /api/cron/sync-blogs)
#   • museum agent — discovers ArtScience/NHB/Gardens exhibitions via search
#   • plan eval pass — per-venue reasoning copy
# Sign up at https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# OpenRouter (optional) — routes LLM calls through OpenRouter so any task's model
# can be swapped to Claude/GPT/etc. via lib/agents/models.ts. UNSET = direct
# Gemini (default; nothing changes). SET = non-grounded calls go through
# OpenRouter using the same model ids (grounded museum/freshness calls stay on
# Gemini, since Google Search grounding is Gemini-only). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Agentic flags default ON. Set any flag to 'false', '0', or 'off' to disable
# that capability for an environment.

# Conversational planner (F1) — chat-first intake + refine-after-results loop.
# AGENTIC_CHAT_ENABLED gates /api/plan/chat and /api/plan/refine (server);
# NEXT_PUBLIC_AGENTIC_CHAT_ENABLED gates the chat/refine UI (client).
# Uses GOOGLE_GEMINI_API_KEY (orchestration model — see lib/agents/models.ts).
AGENTIC_CHAT_ENABLED=
NEXT_PUBLIC_AGENTIC_CHAT_ENABLED=

# Whole-evening itinerary composition (F2) — on-demand "✨ Evening" view that
# sequences a dinner + activity with travel legs + timing feasibility.
# AGENTIC_ITINERARY_ENABLED gates /api/plan/itinerary (server);
# NEXT_PUBLIC_AGENTIC_ITINERARY_ENABLED gates the view toggle (client).
AGENTIC_ITINERARY_ENABLED=
NEXT_PUBLIC_AGENTIC_ITINERARY_ENABLED=

# Verifier debate (F4) — server-only, cron-side. When enabled, the blog-extraction,
# museum-exhibition, AND freshness verifiers run a proposer/skeptic debate +
# deterministic tie-break instead of a single judge (higher precision; doubles
# verifier LLM calls per row). Set AGENTIC_VERIFIER_DEBATE=false for single judge.
AGENTIC_VERIFIER_DEBATE=

# Autonomous source discovery (F4) — no env var; admin-triggered + CRON_SECRET-gated
# at GET /api/admin/discover-sources. Proposes new SG editorial sources for review
# (de-duped + reachability-checked); never auto-adds them to the scan list.

# Longitudinal taste memory (F5) — client-only. When enabled, saves (+1) and
# "Not for us" skips (−1) are logged to a local taste model (signed,
# recency-weighted) that enriches the plan profile and shows an explainable
# "leaning…" hint on the form. Skips counter saves but never feed the hard
# cuisines_avoided filter. localStorage-only (no auth/DB).
NEXT_PUBLIC_AGENTIC_TASTE_ENABLED=

# LLM-narrated taste hint (F5 flesh-out). AGENTIC_TASTE_NARRATE_ENABLED gates the
# /api/taste/narrate endpoint (server); NEXT_PUBLIC_* gates whether the client
# attempts the call. When on, the hint is reworded by COPY_MODEL from the
# AGGREGATED top tags only (never the raw event log) — the single point a taste
# summary leaves the device. Set either flag false to keep the deterministic
# templated hint only; then nothing leaves the device.
AGENTIC_TASTE_NARRATE_ENABLED=
NEXT_PUBLIC_AGENTIC_TASTE_NARRATE_ENABLED=

# Booking concierge — human-in-the-loop safeguard (F3 scaffold). Client-only.
# When enabled, the booking sheet becomes a tiered action-plan gate (party size,
# add-to-calendar, honest "we never book without you" note, audit log) around the
# existing real linkouts. No reservation API is integrated, so it never books for
# you. Set NEXT_PUBLIC_AGENTIC_BOOKING_ENABLED=false for the original sheet.
NEXT_PUBLIC_AGENTIC_BOOKING_ENABLED=

# Supabase (Postgres + RLS for venues, profiles, shortlist_events).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side mirrors. Required for the Supabase JS client when used
# from a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — gates /api/cron/* and /api/admin/reseed.
# Set this in Vercel and Vercel auto-injects it as
# `Authorization: Bearer <secret>` on every scheduled cron call (CRON_SECRET
# is a Vercel-reserved name). For manual local triggers, pass the same
# header yourself: curl -H "Authorization: Bearer $CRON_SECRET" …
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional — gates /api/prewarm.
PREWARM_TOKEN=
