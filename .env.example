# OneMap (free SG government API — sign up at https://www.onemap.gov.sg/apidocs/register)
# Powers POI search (PlaceSearchInput), drive routing (plan flow), and
# public-transit routing (FairnessPill 🚆 toggle).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Supabase (Postgres + RLS for venues, profiles, shortlist_events).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side mirrors. Required for the Supabase JS client when used
# from a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — gates /api/cron/trending so only the cron can trigger refresh.
# Set this in Vercel + match it on the cron's Authorization: Bearer header.
CRON_TOKEN=

# Optional — gates /api/prewarm.
PREWARM_TOKEN=
